{
  "name": "dsh-better-git",
  "version": "0.1.0",
  "description": "Multi-repository Git panel for DSH Better Sidebar",
  "keywords": ["dsh", "dsh-plugin", "git", "sidebar"],
  "type": "module",
  "main": "lib/host.mjs",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/host.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "DEVELOPMENT.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsdown --config tsdown.config.ts",
    "dev": "pnpm build && tsdown --watch --config tsdown.config.ts",
    "dev:client": "tsdown --watch --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.spec.ts\"",
    "test:packed": "pnpm build && node --import tsx --test tests/packed-artifact.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:packed"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.1.3-0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.1.3-0",
    "@deepseek-ai/dsh-web-app": ">=0.1.2-rc.1 <0.1.3-0",
    "dsh-better-sidebar": ">=0.18.0 <0.19.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.2-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "dsh-better-sidebar": "0.18.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
